<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GSoundPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:GSoundPlayer.Controls" xmlns:sys="clr-namespace:System;assembly=System.Runtime" Title="CTECSoundPlayer" Width="1366" Height="728" MinWidth="1100" MinHeight="600" Icon="assets/ctec.ico" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource AppFont}" FontSize="14" FontWeight="{DynamicResource BodyWeight}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" AllowDrop="True" WindowStartupLocation="CenterScreen" xmlns:gsoundplayer="clr-namespace:GSoundPlayer">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <system:Double x:Key="CtlW" xmlns:system="clr-namespace:System;assembly=System.Private.CoreLib">52</system:Double>
      <Thickness x:Key="CtlGap">5,0,0,0</Thickness>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Root" Focusable="True" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None" KeyboardNavigation.DirectionalNavigation="None" FocusVisualStyle="{x:Null}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center">
          <Image Source="assets/ctec_logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="CTECSoundPlayer" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button Name="BtnTrial" Style="{StaticResource Pill}" Margin="12,0,0,0" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnLicenseClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
          <Button Name="BtnMin" Style="{StaticResource WindowBtn}" Content="" Click="OnMinimize" />
          <Button Name="BtnMax" Style="{StaticResource WindowBtn}" Content="" Click="OnMaximize" />
          <Button Name="BtnClose" Style="{StaticResource WindowCloseBtn}" Content="" Click="OnCloseClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" c:Tip.Text="Âm lượng tổng. Kéo nút tròn để đổi, bấm vào thanh không đổi">
            <c:IconView Kind="volume" IconSize="17" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
            <Slider Name="MasterSlider" Width="130" Minimum="-30" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0,6,0" VerticalAlignment="Center" />
            <c:TabularText x:Name="MasterValue" FontSize="12" FontWeight="Bold" MinWidth="46" VerticalAlignment="Center" />
          </StackPanel>
          <Border Name="PillOut" CornerRadius="12" BorderThickness="1" Padding="8,3" Height="24" Margin="0,0,6,0" c:Tip.Text="Trạng thái Output. Chọn Output, bật / tắt chặn app khác ở nút Tùy chỉnh">
            <StackPanel Orientation="Horizontal">
              <Ellipse Name="PillOutDot" Width="8" Height="8" VerticalAlignment="Center" />
              <TextBlock Name="PillOutText" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Button Name="BtnLoud" Style="{StaticResource IconPill}" Margin="0,0,6,0" Click="OnLoudClick">
            <c:IconView x:Name="LoudIcon" Kind="loud" IconSize="17" />
          </Button>
          <Button Name="BtnSet" Style="{StaticResource IconPill}" Margin="0,0,6,0" c:Tip.Text="Tùy chỉnh phát: tắt dần, chuyển bài, đổi hiệu ứng, Output, chặn app khác" Click="OnSettingsClick">
            <c:IconView Kind="settings" IconSize="17" />
          </Button>
          <Button Name="BtnTheme" Style="{StaticResource IconPill}" Margin="0,0,6,0" Click="OnThemeClick">
            <c:IconView x:Name="ThemeIcon" Kind="sun" IconSize="17" />
          </Button>
          <Button Name="BtnFull" Style="{StaticResource IconPill}" Margin="0,0,6,0" c:Tip.Text="Toàn màn hình (thấy được nhiều bài hơn)" Click="OnFullClick">
            <c:IconView Kind="full" IconSize="17" />
          </Button>
          <c:TabularText x:Name="ClockText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource NowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,5">
      <Grid Name="NowGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Name="NowColTitle" Width="260" />
          <ColumnDefinition Name="NowColWave" Width="*" MinWidth="120" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="20" />
          <RowDefinition Height="24" />
          <RowDefinition Height="18" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True">
          <Border Name="NowTag" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" DockPanel.Dock="Left">
            <TextBlock Name="NowTagText" FontSize="12" FontWeight="ExtraBold" />
          </Border>
          <TextBlock Name="FadingInfo" FontSize="12.5" Foreground="{DynamicResource AmberText}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Name="NowTitle" Grid.Row="1" Grid.Column="0" FontSize="19" FontWeight="Bold" LineHeight="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="EndLine" Grid.Row="2" Grid.Column="0" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <c:WaveformView x:Name="Wave" Grid.Column="1" Grid.RowSpan="3" Height="58" Margin="12,0,0,0" Cursor="SizeWE" />
        <StackPanel Name="TimeRow" Grid.Column="2" Grid.RowSpan="3" Margin="12,0,0,0" VerticalAlignment="Center">
          <Border Name="StBanner" CornerRadius="5" Padding="6,1">
            <TextBlock Name="StBannerText" FontSize="12" FontWeight="ExtraBold" LineHeight="16" TextTrimming="CharacterEllipsis" />
          </Border>
          <DockPanel Margin="0,2,0,0">
            <Button Name="BtnCancelFade" Style="{StaticResource Btn}" DockPanel.Dock="Right" Height="18" Padding="8,0" FontSize="11.5" FontWeight="ExtraBold" VerticalAlignment="Center" Background="#1b1407" Foreground="#FFFFFFFF" BorderThickness="0" Content="HỦY" Visibility="Collapsed" c:Tip.Text="Hủy tắt dần, nhạc lên lại" Click="OnCancelFade" />
            <c:TabularText x:Name="Remain" Margin="6,0,0,0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Text="00:00" />
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" Grid.RowSpan="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Name="BtnPrev" Style="{StaticResource IconBtn}" c:Tip.Text="Về đầu bài. Trong 3 giây đầu bài: về bài trước" c:Tip.Key="Shift+←" Click="OnPrev">
            <c:IconView Kind="prev" />
          </Button>
          <Button Name="BtnBack" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Lùi 10 giây" Click="OnBack">
            <Grid>
              <c:IconView Kind="back" />
              <TextBlock Text="10" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" IsHitTestVisible="False" />
            </Grid>
          </Button>
          <Button Name="BtnFwd" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Tới 10 giây" Click="OnFwd">
            <Grid>
              <c:IconView Kind="fwd" />
              <TextBlock Text="10" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" IsHitTestVisible="False" />
            </Grid>
          </Button>
          <Button Name="BtnNext" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Phát bài KẾ TIẾP" c:Tip.Key="Shift+→" Click="OnNext">
            <c:IconView Kind="next" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="4" Grid.RowSpan="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Name="BtnFade" Style="{StaticResource IconBtn}" c:Ui.State="fade" c:Tip.Key="Esc" Click="OnFade">
            <Grid>
              <c:IconView Kind="fade" />
              <TextBlock Name="FadeLabel" Style="{StaticResource CtlSmall}" />
            </Grid>
          </Button>
          <Button Name="BtnStop" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Dừng ngay, không tắt dần" c:Tip.Key="Shift+Esc" Click="OnStop">
            <c:IconView Kind="stop" />
          </Button>
          <Button Name="BtnPause" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Tạm dừng" c:Tip.Key="P" Click="OnPause">
            <c:IconView x:Name="PauseIcon" Kind="pause" />
          </Button>
          <Button Name="BtnDuck" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Bật / tắt MC nói: hạ nhạc −12 dB khi MC nói" c:Tip.Key="M" Click="OnDuck">
            <Grid>
              <c:IconView Kind="mic" />
              <TextBlock Text="−12 dB" Style="{StaticResource CtlSmall}" />
            </Grid>
          </Button>
          <Button Name="BtnLoop" Style="{StaticResource IconBtn}" Margin="{DynamicResource CtlGap}" c:Tip.Text="Lặp bài đang phát" c:Tip.Key="L" Click="OnLoop">
            <c:IconView Kind="loop" />
          </Button>
          <Grid Margin="{DynamicResource CtlGap}">
            <Button Name="BtnPanic" Style="{StaticResource IconBtn}" c:Ui.State="danger" c:Tip.Text="Giữ nút nửa giây để dừng tất cả: nhạc và hiệu ứng" c:Tip.Key="Giữ Esc 1 s" PreviewMouseLeftButtonDown="OnPanicDown" PreviewMouseLeftButtonUp="OnPanicUp">
              <Grid>
                <c:IconView Kind="panic" />
                <TextBlock Text="TẤT CẢ" Style="{StaticResource CtlSmall}" />
              </Grid>
            </Button>
            <Border Name="PanicFill" Background="{DynamicResource Red}" Opacity="0.55" HorizontalAlignment="Left" Width="0" CornerRadius="7" IsHitTestVisible="False" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="5" Grid.RowSpan="3" Orientation="Horizontal" Margin="12,0,0,0">
          <c:LevelMeter x:Name="MeterL" Width="12" Height="58" />
          <c:LevelMeter x:Name="MeterR" Width="12" Height="58" Margin="4,0,0,0" />
        </StackPanel>
        <Border Name="AlertBar" Grid.ColumnSpan="6" Grid.RowSpan="3" Margin="-12,-5" Background="#F23C080A" BorderBrush="{DynamicResource Red}" BorderThickness="2" Visibility="Collapsed">
          <DockPanel Margin="14,0">
            <Button Name="BtnTempOut" DockPanel.Dock="Right" Style="{StaticResource Btn}" Height="34" Padding="14,0" Margin="10,0,0,0" FontSize="13" FontWeight="ExtraBold" Background="#00FFFFFF" BorderBrush="#ffd6d7" Foreground="#ffd6d7" Content="Phát tạm ra loa laptop" Click="OnTempOut" />
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <c:IconView Kind="alert" IconSize="20" Foreground="#FFFFFFFF" Margin="0,0,8,0" />
                <TextBlock Name="AlertTitle" Text="MẤT OUTPUT: dây jack vừa bị rút" FontSize="17" FontWeight="ExtraBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Name="AlertMsg" FontSize="12.5" Foreground="#ffd6d7" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="Đã tạm dừng mọi bài để nhạc không phát ra loa laptop. Cắm lại dây xong, nhạc vẫn chờ: bấm P để phát tiếp, nhạc lên dần 2 giây." />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Row="2" Margin="8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="356" />
      </Grid.ColumnDefinitions>
      <Border Name="LibPanel" Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="8,4,8,3">
            <Grid DockPanel.Dock="Left" Width="146">
              <TextBox Name="SearchBox" Height="30" FontSize="13.5" TextChanged="OnSearchChanged" />
              <StackPanel Name="SearchHint" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <c:IconView Kind="search" IconSize="15" Foreground="{DynamicResource Muted}" Margin="0,0,6,0" />
                <TextBlock Text="Bấm rồi gõ tên bài" FontSize="13.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Button Name="BtnImport" DockPanel.Dock="Right" Style="{StaticResource HBtn}" c:Ui.State="add" Margin="6,0,0,0" Height="30" ToolTip="Nạp nhạc vào kho (Ctrl+O). Kéo thả file vào cửa sổ cũng được" Click="OnImportClick">
              <StackPanel Orientation="Horizontal">
                <c:IconView Kind="plus" IconSize="14" Margin="0,0,4,0" />
                <TextBlock Text="Nạp" VerticalAlignment="Center" />
                <Border Name="ImpBadge" Background="{DynamicResource Amber}" CornerRadius="8" Padding="4,0" Margin="4,0,0,0" Visibility="Collapsed">
                  <TextBlock Name="ImpBadgeText" FontSize="11" FontWeight="ExtraBold" Foreground="#1b1407" />
                </Border>
              </StackPanel>
            </Button>
            <Button Name="BtnCue" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Margin="6,0,0,0" Height="30" ToolTip="Kịch bản sự kiện: danh sách cue, ghi chú MC, tự chạy cue tiếp và đồng hồ sân khấu" Click="OnCueClick">
              <StackPanel Orientation="Horizontal">
                <c:IconView Kind="list-plus" IconSize="14" Margin="0,0,4,0" />
                <TextBlock Text="Kịch bản" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnListMenu" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Width="32" Height="30" Padding="0" Margin="6,0,0,0" ToolTip="Danh sách nhạc: nhập, xuất, tìm bài thiếu file, xóa tất cả bài" Click="OnListMenu">
              <c:IconView Kind="more" IconSize="16" />
            </Button>
            <StackPanel Name="Pager" DockPanel.Dock="Right" Orientation="Horizontal" Margin="2,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Kho nhạc chia trang để không phải cuộn">
              <Button Name="BtnPagePrev" Style="{StaticResource Btn}" Width="26" Height="30" ToolTip="Trang trước" Click="OnPagePrev">
                <c:IconView Kind="chev-left" IconSize="14" />
              </Button>
              <TextBlock Name="PagerText" FontSize="13.5" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center" />
              <Button Name="BtnPageNext" Style="{StaticResource Btn}" Width="26" Height="30" ToolTip="Trang sau" Click="OnPageNext">
                <c:IconView Kind="chev-right" IconSize="14" />
              </Button>
            </StackPanel>
            <WrapPanel Name="Chips" Margin="6,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <c:LibraryGrid x:Name="LibGrid" Grid.Row="1" />
          <Grid Name="ItemEd" RowSpan="2" Background="{DynamicResource Panel}" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="34" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <DockPanel Margin="8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource HBtn}" Click="OnItemClose">
                  <StackPanel Orientation="Horizontal">
                    <c:IconView Kind="check" IconSize="13" Margin="0,0,4,0" />
                    <TextBlock Text="Xong" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Name="BtnItemDelete" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Margin="0,0,16,0" Foreground="{DynamicResource RedText}" BorderBrush="{DynamicResource Red}" ToolTip="Xóa bài này khỏi kho nhạc (hỏi lại trước khi xóa). Bài đang kêu thì tắt bài rồi mới xóa được" Click="OnItemDelete">
                  <StackPanel Orientation="Horizontal">
                    <c:IconView Kind="trash" IconSize="13" Margin="0,0,4,0" />
                    <TextBlock Text="Xóa khỏi kho…" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="SỬA BÀI" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="lưu ngay cho bài này, không sửa file gốc" FontSize="12.5" Margin="8,0,0,0" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
              <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.45*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Tên hiển thị" FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,0,0,4" />
                  <TextBox Name="IName" Height="32" FontSize="14" TextChanged="OnItemName" />
                  <TextBlock Text="Ghi chú cho người chạy (hiện ở ô KẾ TIẾP)" FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,11,0,4" />
                  <TextBox Name="INote" Height="32" FontSize="14" TextChanged="OnItemNote" />
                  <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,11,0,0">
                    <DockPanel>
                      <Button Name="BtnItemReplace" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Height="26" Margin="8,0,0,0" Content="Thay bằng bài khác…" ToolTip="Đổi sang file khác, bài giữ nguyên chỗ trong hàng chờ, nhóm, sao và ghi chú. Bài đang phát thì dừng bài rồi mới thay được" Click="OnItemReplace" />
                      <c:IconView DockPanel.Dock="Left" Kind="music" IconSize="15" Foreground="{DynamicResource Ink2}" Margin="0,0,6,0" />
                      <TextBlock Name="IFile" FontSize="13" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <c:WaveformView x:Name="IWave" MouseLeftButtonDown="OnIWaveDown" MouseMove="OnIWaveMove" MouseLeftButtonUp="OnIWaveUp" Height="150" Margin="0,11,0,0" Cursor="SizeWE" Handles="True" />
                  <TextBlock Text="Kéo vạch VÀO / RA để chọn đoạn phát. Đường vàng là lên dần / tắt dần." FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,4,0,0" />
                  <DockPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                      <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}">Vào <Bold><Run Name="IIn" Foreground="{DynamicResource Ink}" /></Bold></TextBlock>
                      <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}" Margin="14,0,0,0">Ra <Bold><Run Name="IOut" Foreground="{DynamicResource Ink}" /></Bold></TextBlock>
                      <TextBlock FontSize="13" Foreground="{DynamicResource Ink2}" Margin="14,0,0,0">Phát <Bold><Run Name="ILen" Foreground="{DynamicResource Ink}" /></Bold></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Style="{StaticResource HBtn}" Height="28" Content="Bỏ khoảng im đầu bài" Click="OnItemSilence" />
                      <Button Name="BtnItemReset" Style="{StaticResource HBtn}" Height="28" Margin="6,0,0,0" Content="Về nguyên bài" ToolTip="Bỏ mọi chỉnh sửa đoạn phát, fade, âm lượng của bài này" Click="OnItemReset" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
                <StackPanel Name="ItemRight" Grid.Column="2" />
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      <Border Name="CueDrawer" Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0,8,0">
              <Button Name="BtnCueBack" AutomationProperties.Name="CueBack" DockPanel.Dock="Left" Style="{StaticResource HBtn}" Height="28" Padding="8,0" Click="OnCueBackClick" ToolTip="Quay lại kho nhạc (Ctrl+K)">
                <StackPanel Orientation="Horizontal">
                  <c:IconView Kind="chev-left" IconSize="12" Margin="0,0,5,0" />
                  <TextBlock Text="Kho nhạc" VerticalAlignment="Center" FontSize="12.5" />
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <c:IconView Kind="list-plus" IconSize="16" Foreground="{DynamicResource AmberText}" Margin="0,0,7,0" />
                <TextBlock Text="KỊCH BẢN SỰ KIỆN" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="  ·  điều khiển chương trình theo cue" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Name="BtnCueMenu" AutomationProperties.Name="BtnCueMenu" Style="{StaticResource HBtn}" Height="28" Padding="9,0" Click="OnCueMenuClick" ToolTip="Mẫu sự kiện, nhập hàng chờ, đổi tên, nhân bản, xóa kịch bản">
                  <StackPanel Orientation="Horizontal">
                    <c:IconView Kind="more" IconSize="12" Margin="0,0,5,0" />
                    <TextBlock Text="Tùy chọn" VerticalAlignment="Center" FontSize="12.5" />
                  </StackPanel>
                </Button>
                <Button Name="BtnCueClose" AutomationProperties.Name="BtnCueClose" Style="{StaticResource HBtn}" Width="30" Height="28" Padding="0" Margin="6,0,0,0" Click="OnCueCloseClick" ToolTip="Đóng kịch bản (Ctrl+K)">
                  <c:IconView Kind="x" IconSize="12" />
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" Margin="10,9,10,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="CueShowBox" AutomationProperties.Name="CueShowBox" Width="290" Height="30" FontSize="13.5" DropDownClosed="OnCueShowDropped" ToolTip="Chọn kịch bản sự kiện" />
            <Button Name="BtnCueNewShow" AutomationProperties.Name="BtnCueNewShow" Grid.Column="1" Style="{StaticResource HBtn}" Width="30" Height="30" Padding="0" Margin="6,0,0,0" Click="OnCueNewShowClick" ToolTip="Tạo chương trình / sự kiện mới từ mẫu sự kiện">
              <c:IconView Kind="plus" IconSize="13" />
            </Button>
            <TextBlock Name="CueCountText" Grid.Column="2" FontSize="12.5" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="12,0,8,0" Text="0 cue" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Name="BtnCueAdd" AutomationProperties.Name="BtnCueAdd" Style="{StaticResource Primary}" Height="30" Padding="10,0" Click="OnCueAddClick">
                <StackPanel Orientation="Horizontal">
                  <c:IconView Kind="plus" IconSize="12" Margin="0,0,5,0" />
                  <TextBlock Text="Thêm cue" VerticalAlignment="Center" FontSize="12.5" />
                </StackPanel>
              </Button>
              <Button Name="BtnCueReset" AutomationProperties.Name="BtnCueReset" Style="{StaticResource HBtn}" Height="30" Margin="6,0,0,0" Padding="8,0" Click="OnCueResetClick" ToolTip="Về cue đầu tiên">
                <StackPanel Orientation="Horizontal">
                  <c:IconView Kind="undo" IconSize="12" Margin="0,0,5,0" />
                  <TextBlock Text="Từ đầu" VerticalAlignment="Center" FontSize="12.5" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="366" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <ScrollViewer Name="CueScroll" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="6,4,6,4">
                  <StackPanel Name="CueRows" />
                </ScrollViewer>
              </Border>
              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Button Name="BtnCuePrev" AutomationProperties.Name="BtnCuePrev" Style="{StaticResource Btn}" Height="54" Padding="0" Click="OnCuePrevClick" ToolTip="Cue trước (↑)">
                  <c:IconView Kind="chev-left" IconSize="15" />
                </Button>
                <Button Name="BtnCueGo" AutomationProperties.Name="BtnCueGo" Grid.Column="1" Style="{StaticResource Btn}" Height="54" Margin="7,0" Background="{DynamicResource GoBg}" BorderBrush="#2fdc7a" Foreground="#FFFFFFFF" Click="OnCueGoClick" ToolTip="Phát cue đang chọn (Enter)">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GO" FontSize="25" FontWeight="ExtraBold" TextAlignment="Center" LineHeight="27" />
                    <TextBlock Name="CueGoSmall" Text="cue đang chọn" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.9" />
                  </StackPanel>
                </Button>
                <Button Name="BtnCueNext" AutomationProperties.Name="BtnCueNext" Grid.Column="2" Style="{StaticResource Btn}" Height="54" Padding="0" Click="OnCueNextClick" ToolTip="Cue tiếp (↓)">
                  <c:IconView Kind="chev-right" IconSize="15" />
                </Button>
              </Grid>
            </Grid>
            <Border Grid.Column="2" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                  <TextBlock Text="CUE ĐANG CHỌN" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource AmberText}" />
                  <TextBlock Name="CueDetailTitle" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0" Text="Chưa chọn cue" />
                  <TextBlock Name="CueDetailTrack" FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0" Text="Chọn một cue trong danh sách." />
                  <TextBlock Name="CueDetailMeta" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="GHI CHÚ MC" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource AmberText}" />
                      <ScrollViewer MaxHeight="62" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock Name="CueNoteText" FontSize="12.5" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0" Text="Chọn một cue để xem ghi chú." />
                      </ScrollViewer>
                    </StackPanel>
                  </Border>
                  <TextBlock Name="CueDetailFollow" FontSize="12" Foreground="{DynamicResource GreenText}" Margin="0,8,0,0" Text="Tự chạy cue tiếp: BẬT" />
                  <Button Name="BtnCuePlay" AutomationProperties.Name="BtnCuePlay" Style="{StaticResource Primary}" Height="36" Margin="0,10,0,0" Click="OnCuePlayClick">
                    <StackPanel Orientation="Horizontal">
                      <c:IconView Kind="play" IconSize="13" Margin="0,0,6,0" />
                      <TextBlock Text="Chạy cue này" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                  <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="7" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="BtnCueEdit" AutomationProperties.Name="BtnCueEdit" Style="{StaticResource HBtn}" Height="32" Click="OnCueEditClick">
                      <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="pencil" IconSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Sửa cue" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Name="BtnCueAssign" AutomationProperties.Name="BtnCueAssign" Grid.Column="2" Style="{StaticResource HBtn}" Height="32" Click="OnCueAssignClick" ToolTip="Gán bài đang chọn trong kho vào cue này">
                      <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="music" IconSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Gán bài" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="7" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="BtnCueBeat" AutomationProperties.Name="BtnCueBeat" Style="{StaticResource HBtn}" Height="32" Click="OnCueBeatClick" ToolTip="Nạp beat hoặc file nhạc mới rồi gán ngay vào cue này">
                      <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="plus" IconSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Thêm beat" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Name="BtnCueDelete" AutomationProperties.Name="BtnCueDelete" Grid.Column="2" Style="{StaticResource HBtn}" Height="32" Click="OnCueDeleteClick" Foreground="{DynamicResource RedText}" ToolTip="Xóa cue này khỏi kịch bản">
                      <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="trash" IconSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Xóa cue" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="ĐỒNG HỒ SÂN KHẤU" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource Ink2}" />
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Name="CueTimeText" FontSize="26" FontWeight="Bold" Text="05:00" VerticalAlignment="Center" />
                        <TextBox Name="CueMinutes" AutomationProperties.Name="CueMinutes" Width="42" Height="26" FontSize="12.5" Margin="10,0,0,0" VerticalContentAlignment="Center" Text="5" ToolTip="Số phút đếm ngược" TextChanged="OnCueMinutesChanged" />
                        <TextBlock Text="phút" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Name="BtnCueTimer" AutomationProperties.Name="BtnCueTimer" Style="{StaticResource HBtn}" Width="34" Height="30" Padding="0" Click="OnCueTimerClick" ToolTip="Bắt đầu / tạm dừng đồng hồ">
                          <c:IconView Kind="play" IconSize="12" />
                        </Button>
                        <Button Style="{StaticResource HBtn}" Width="34" Height="30" Padding="0" Margin="6,0,0,0" Click="OnCueTimerResetClick" ToolTip="Đặt lại đồng hồ">
                          <c:IconView Kind="undo" IconSize="13" />
                        </Button>
                        <TextBlock Text="Enter: chạy cue · Ctrl+K: đóng" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Grid Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="NextBar" Grid.Row="0" Background="{DynamicResource NextBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="9,7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="5" />
              <RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <StackPanel Name="NextInfo" Grid.ColumnSpan="3">
              <TextBlock Name="NextLabel" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource AmberText}" LineHeight="15" />
              <TextBlock Name="NextTitle" FontSize="18" FontWeight="Bold" LineHeight="23" TextTrimming="CharacterEllipsis" />
              <TextBlock Name="NextNote" FontSize="15" LineHeight="19" Height="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}" />
            </StackPanel>
            <Button Name="BtnGo" Grid.Row="2" Grid.Column="0" Style="{StaticResource Btn}" c:Ui.Radius="10" Background="{DynamicResource GoBg}" BorderBrush="#2fdc7a" Foreground="#FFFFFFFF" Click="OnGo">
              <Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Name="GoLabel" Text="GO" FontSize="28" FontWeight="ExtraBold" TextAlignment="Center" LineHeight="30" />
                  <TextBlock Name="GoSmall" Text="Space" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.9" />
                </StackPanel>
              </Grid>
            </Button>
            <Border Name="LockBar" Grid.Row="2" Grid.Column="0" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#FFFFFFFF" Width="0" IsHitTestVisible="False" />
            <Button Name="BtnUndo" Grid.Row="2" Grid.Column="2" Style="{StaticResource Btn}" Padding="7,3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{DynamicResource Ink2}" c:Tip.Text="Phát lại bài vừa bị tắt, từ đúng chỗ đang dừng. Đang có nhạc thì giữ nửa giây" c:Tip.Key="Backspace" Click="OnUndo">
              <DockPanel>
                <c:IconView DockPanel.Dock="Left" Kind="undo" IconSize="15" Margin="0,0,6,0" />
                <TextBlock Name="UndoText" FontSize="12.5" LineHeight="15" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="34">
              <DockPanel Margin="8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource HBtn}" Width="32" Padding="0" Margin="6,0,0,0" ToolTip="Chọn cả thư mục hiệu ứng: các file được gán lần lượt vào phím 1–9. Thả thư mục vào ô hiệu ứng cũng được" Click="OnFxFolder">
                  <c:IconView Kind="folder" IconSize="15" />
                </Button>
                <Button Name="BtnFxStop" DockPanel.Dock="Right" Style="{StaticResource HBtn}" c:Ui.State="add" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Tắt mọi hiệu ứng đang kêu (phím 0). Nhạc vẫn chạy" Click="OnFxStopAll">
                  <StackPanel Orientation="Horizontal">
                    <c:IconView Kind="stop" IconSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="Tắt hết" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="HIỆU ỨNG" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Name="FxHint" Text="phím 1–9 · 0 tắt hết" FontSize="12.5" Margin="6,0,0,0" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
                <DockPanel HorizontalAlignment="Right" Margin="8,0,0,0">
                  <c:IconView x:Name="FxActiveIcon" DockPanel.Dock="Left" Kind="music" IconSize="13" Foreground="{DynamicResource AmberText}" Margin="0,0,4,0" Visibility="Collapsed" />
                  <TextBlock Name="FxActive" FontSize="12.5" Foreground="{DynamicResource AmberText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DockPanel>
            </Border>
            <UniformGrid Name="FxGrid" Columns="3" Rows="3" Margin="3" />
          </StackPanel>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="34">
              <DockPanel Margin="8,0">
                <Button Name="BtnQOpts" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Width="32" Padding="0" Margin="6,0,0,0" ToolTip="Tùy chọn hàng chờ: phát xong có bỏ bài khỏi hàng chờ không, có lặp lại không" Click="OnQueueOptions">
                  <c:IconView Kind="settings" IconSize="15" />
                </Button>
                <CheckBox Name="AutoQueueBox" DockPanel.Dock="Right" FontSize="12.5" VerticalAlignment="Center" IsChecked="True" ToolTip="Tự phát bài chờ: bài đang phát hết thì tự chuyển sang bài chờ kế tiếp. Tắt thì hết bài là dừng, bấm GO mới phát bài chờ" Content="Tự phát" Click="OnAutoQueue" />
                <Button Name="BtnQClear" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Bỏ hết bài khỏi hàng chờ (hỏi lại trước). Bài vẫn còn trong kho" Click="OnQueueClear">
                  <StackPanel Orientation="Horizontal">
                    <c:IconView Kind="x" IconSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="Bỏ hết" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="HÀNG CHỜ" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Name="QCount" FontSize="12.5" Margin="6,0,0,0" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <ScrollViewer Name="QScroll" VerticalScrollBarVisibility="Auto" Focusable="False" AllowDrop="True" Background="#00FFFFFF">
              <Grid Name="QHost">
                <StackPanel Name="QList" Margin="4,2" />
                <Border Name="QDropLine" Height="3" CornerRadius="1.5" VerticalAlignment="Top" Background="{DynamicResource Green2}" IsHitTestVisible="False" Visibility="Collapsed" />
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Name="WarnPop" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="16,10" MaxWidth="760" CornerRadius="9" BorderThickness="1" Background="{DynamicResource ToastWarnBg}" BorderBrush="{DynamicResource Amber}" IsHitTestVisible="False" Visibility="Collapsed">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" />
      </UIElement.Effect>
      <DockPanel>
        <c:IconView DockPanel.Dock="Left" Kind="alert" IconSize="20" Foreground="{DynamicResource ToastWarnInk}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Name="WarnPopText" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource ToastWarnInk}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border Grid.Row="3" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" ClipToBounds="True">
      <Grid>
        <StackPanel Name="StatusKeys" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
          <Button Name="BtnKeys" Style="{StaticResource HBtn}" Height="23" Margin="10,0,0,0" Click="OnHelpClick">
            <StackPanel Orientation="Horizontal">
              <c:IconView Kind="keyboard" IconSize="14" Margin="0,0,5,0" />
              <TextBlock Text="Tất cả phím tắt" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Name="StatusRight" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5" Foreground="{DynamicResource Muted}" />
        <Border Name="ToastBar" Visibility="Collapsed">
          <DockPanel Margin="14,0">
            <Button Name="ToastAction" DockPanel.Dock="Right" Style="{StaticResource HBtn}" Height="23" Visibility="Collapsed" />
            <TextBlock Name="ToastText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border Name="SetPop" Grid.RowSpan="4" Width="430" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,10,0" Padding="14,12" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" />
      </UIElement.Effect>
      <StackPanel Name="SetBody" />
    </Border>
    <Canvas Name="MenuLayer" Grid.RowSpan="4" Visibility="Collapsed" Background="#00FFFFFF" MouseDown="OnMenuLayerDown">
      <Border Name="MenuBox" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="240">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" />
        </UIElement.Effect>
        <StackPanel Name="MenuBody" />
      </Border>
    </Canvas>
    <Grid Name="Modal" RowSpan="4" Background="{DynamicResource DimBg}" Visibility="Collapsed" MouseDown="OnModalBackdrop">
      <Border Name="ModalBox" Background="{DynamicResource HelpBg}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="12" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="OnModalBoxDown">
        <ScrollViewer Name="ModalScroll" VerticalScrollBarVisibility="Auto" Focusable="False" />
      </Border>
    </Grid>
    <Border Name="DropOverlay" Grid.RowSpan="4" Background="#DB073C22" BorderBrush="#35d07f" BorderThickness="4" IsHitTestVisible="False" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center">
        <c:IconView Kind="download" IconSize="56" Foreground="#FFFFFFFF" Margin="0,0,0,10" />
        <TextBlock Text="Thả vào đây để nạp vào kho nhạc" FontSize="34" FontWeight="ExtraBold" Foreground="#FFFFFFFF" TextAlignment="Center" />
        <TextBlock Text="File nhạc hoặc cả thư mục. File danh sách phát (.gsplayer, .m3u) thì hỏi trước khi nhập" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFFFF" TextAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>